{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce.local/schemas/events/order-created.v1.schema.json",
  "title": "OrderCreatedV1",
  "description": "Event published by Order Service after an order is stored successfully.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "correlation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "order.created"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oid",
        "uid",
        "subtotal",
        "discount_amount",
        "total_amount",
        "items"
      ],
      "properties": {
        "oid": {
          "type": "integer",
          "minimum": 1
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "subtotal": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "discount_amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "total_amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pid",
              "pname",
              "qty",
              "unit_price",
              "line_total"
            ],
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1
              },
              "pname": {
                "type": "string",
                "minLength": 1
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
              },
              "line_total": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
              }
            }
          }
        }
      }
    }
  }
}
