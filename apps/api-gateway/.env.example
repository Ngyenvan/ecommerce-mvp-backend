NODE_ENV="development"
PORT="3000"

AUTH_GRPC_URL="localhost:50051"
CUSTOMER_GRPC_URL="localhost:50052"
PRODUCT_GRPC_URL="localhost:50053"
ORDER_GRPC_URL="localhost:50054"
SHIPMENT_GRPC_URL="localhost:50055"

JWT_ACCESS_SECRET="replace_with_the_same_auth_service_secret"
